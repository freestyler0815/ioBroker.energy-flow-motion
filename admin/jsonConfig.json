{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_generalSetup": {
            "type": "panel",
            "label": "General Setup",
            "items": {
                "updateInterval":{
                    "type": "number",
                    "min": 1,
                    "max": 10,
                    "sm": 2,
                    "md": 2,
                    "lg": 2,
                    "default": 2,
                    "label": "UpdateInterval",
                    "help": "Update Interval in seconds (1 to 10s possible)"
                },                
                "importThreshold":{
                        "type": "number",
                        "min": 0,
                        "max": 500,
                        "sm": 2,
                        "md": 2,
                        "lg": 2,
                        "default": 50,
                        "label": "Import Power Threshold (W)",
                        "help": "Threshold in Watt to detect importing Power from Grid (0W to 500W possible)"
                },                
                "exportThreshold":{
                        "type": "number",
                        "min": 0,
                        "max": 500,
                        "sm": 2,
                        "md": 2,
                        "lg": 2,
                        "default": 50,
                        "label": "Export Power Threshold (W)",
                        "help": "Threshold in Watt to detect exporting Power to Grid (0W to 500W possible)"
                },                
                "PVkWp":{
                        "type": "number",
                        "sm": 2,
                        "md": 2,
                        "lg": 2,
                        "label": "PV kWp",
                        "help": "PV installed kW Peak Power"
                },                
                "powerControlActive":{
                        "newLine": true,
                        "type": "checkbox",
                        "sm": 2,
                        "md": 1,
                        "lg": 1,
                        "default": false,
                        "label": "Power Control active",
                        "help": "Activate Power Control"
                },
                "powerControlActivationDelay":{
                        "type": "number",
                        "min": 0,
                        "max": 10,                        
                        "sm": 2,
                        "md": 2,
                        "lg": 2,
                        "default": 1,
                        "label": "Power Control Activation Delay",
                        "help": "Amount of Update-Intervalls to delay the activation of a Power Channel"
                },                
                "energyStorageControlActive":{
                    "newLine": true,
                    "type": "checkbox",                    
                    "sm": 2,
                    "md": 1,
                    "lg": 1,
                    "label": "Energy Storage Control Active",
                    "help": "Activate Energy Storage Control"
                },
                "energyCounterMonthActive":{
                    "newLine": true,
                    "type": "checkbox",
                    "sm": 2,
                    "md": 1,
                    "lg": 1,
                    "label": "Energy Counter Month Active",
                    "help": "Activate monthly Energy Counter"
                },
                "energyCounterYearActive":{
                    "type": "checkbox",
                    "sm": 2,
                    "md": 1,
                    "lg": 1,
                    "label": "Energy Counter Year Active",
                    "help": "Activate yearly Energy Counter"
                }            
            }
        },
        "_pvPowerData":{
            "type": "panel",
            "label": "PV Power Data",
            "items": {
                "pvPowerDataTable":{
                    "type": "table",
                    "label": "Pv Power Data Source Table",
                    "items": [
                        {
                            "type": "objectId",
                            "attr": "pwrObjectId",
                            "width": "250px",
                            "title": {"en": "ObjectID"},                            
                            "filter": false,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Factor (+/-)"},
                            "attr": "pwrFactor",
                            "filter": false,
                            "sort": true,
                            "step": 0.001,
                            "min": -1,
                            "max": 1,
                            "default": "1"
                        }
                    ]

                }
            }

        },
        "_loadPowerData":{
            "type": "panel",
            "label": "Load Power Data",
            "items": {
                "loadDataTable":{
                    "type": "table",
                    "label": "Load Power Data Source Table",
                    "items": [
                        {
                            "type": "objectId",
                            "width": "250px",
                            "title": {"en": "ObjectID"},
                            "attr": "pwrObjectId",
                            "filter": false,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Factor (+/-)"},
                            "attr": "pwrFactor",
                            "filter": false,
                            "sort": true,
                            "step": 0.001,
                            "min": -1,
                            "max": 1,
                            "default": "1"
                        }
                    ]

                }
            }
        },
        "_gridPowerData":{
            "type": "panel",
            "label": "Grid Power Data",
            "items": {
                "exportDataTable":{
                    "type": "table",
                    "label": "Grid Export Power Data Source Table",
                    "items": [
                        {
                            "type": "objectId",
                            "width": "250px",
                            "title": {"en": "ObjectID"},
                            "attr": "pwrObjectId",
                            "filter": false,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Factor (+/-)"},
                            "attr": "pwrFactor",
                            "filter": false,
                            "sort": true,
                            "step": 0.001,
                            "min": -1,
                            "max": 1,
                            "default": "1"
                        }
                    ]

                },
                "importDataTable":{
                    "newLine": true,
                    "type": "table",
                    "label": "Grid Import Power Data Source Table",
                    "items": [
                        {
                            "type": "objectId",
                            "width": "250px",
                            "title": {"en": "ObjectID"},
                            "attr": "pwrObjectId",
                            "filter": false,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Factor (+/-)"},
                            "attr": "pwrFactor",
                            "filter": false,
                            "sort": true,
                            "step": 0.001,
                            "min": -1,
                            "max": 1,
                            "default": "1"
                        }
                    ]

                }
            }
        },
        "_loadPowerControlChannels":{
            "type": "panel",
            "label": "Load Power Control Channels",
            "items": {
                "powerControlChannels":{
                    "type": "table",
                    "label": "Load Power Control Channels",
                    "items": [
                        {
                            "type": "checkbox",
                            "width": "15px",
                            "title": {"en": "Enable"},
                            "attr": "pwcChannelEnabled",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": true
                        },
                        {
                            "type": "text",
                            "width": "150px",
                            "title": {"en": "Title"},
                            "attr": "pwcChannelTitle",
                            "filter": false,
                            "sort": true,
                            "default": "CH(x)"
                        },
                        {
                            "type": "text",
                            "width": "250px",
                            "title": {"en": "Description"},
                            "attr": "pwcChannelDescription",
                            "filter": false,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Max. Power (kW)"},
                            "attr": "pwcChannelMaxPower",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": 0,
                            "min": 0
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Min. Power (kW)"},
                            "attr": "pwcChannelMinPower",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": 0,
                            "min": 0
                        },
                        {
                            "type": "number",
                            "width": "20px",
                            "title": {"en": "Step Size (kW)"},
                            "attr": "pwcChannelStepSize",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": 0,
                            "min": 0
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Shutdown Delay (s)"},
                            "attr": "pwcChannelShutdownDelay",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": "30"
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Activation Delay (s)"},
                            "attr": "pwcChannelActivationDelay",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": "2"
                        }
                    ],
                    "uniqueColumns": ["pwcChannelTitle"],
                    "export": true,
                    "import": true
                }
            }
        },
        "_energyStorageChannels":{
            "type": "panel",
            "label": "Energy Storage Channels",
            "items": {
                "energyStorageControlChannels":{
                    "type": "table",
                    "label": "Energy Storage Channels",
                    "items": [
                        {
                            "type": "checkbox",
                            "width": "10px",
                            "title": {"en": "Enable Channel"},
                            "attr": "esChannelEnabled",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": true
                        },
                        {
                            "type": "checkbox",
                            "width": "10px",
                            "title": {"en": "Enable EFM Control"},
                            "attr": "esEfmControlEnabled",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": true
                        },
                        {
                            "type": "text",
                            "width": "150px",
                            "title": {"en": "Title"},
                            "attr": "esChannelTitle",
                            "filter": false,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "text",
                            "width": "250px",
                            "title": {"en": "Description"},
                            "attr": "esChannelDescription",
                            "filter": false,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Capacity (kWh)"},
                            "attr": "esCapacity",
                            "filter": false,
                            "sort": true,
                            "step": 0.1,
                            "min": 0,
                            "unit": "kWh",
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Max. Charge Power (kW)"},
                            "attr": "esMaxChargePower",
                            "filter": false,
                            "step": 0.1,
                            "min": 0,
                            "unit": "kW",
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Min. Charge Power (kW)"},
                            "attr": "esMinChargePower",
                            "filter": false,
                            "step": 0.1,
                            "min": 0,
                            "unit": "kW",
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "objectId",
                            "width": "50px",
                            "title": {"en": "Charge Power (kW)"},
                            "attr": "esChargePower",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Charge Power Factor (+/-)"},
                            "attr": "esChgPwrFactor",
                            "filter": false,
                            "sort": true,
                            "step": 0.001,
                            "min": -1,
                            "max": 1,
                            "default": "1"
                        },
                        {
                            "type": "number",
                            "width": "20px",
                            "title": {"en": "Step Size (kW)"},
                            "attr": "esChannelStepSize",
                            "filter": false,
                            "step": 0.01,
                            "min": 0,
                            "unit": "kW",
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Max. Discharge Power (kW)"},
                            "attr": "esMaxDischargePower",
                            "filter": false,
                            "step": 0.1,
                            "min": 0,
                            "unit": "kW",
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Min. Discharge Power (kW)"},
                            "attr": "esMinDischargePower",
                            "filter": false,
                            "step": 0.1,
                            "min": 0,
                            "unit": "kW",
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "objectId",
                            "width": "50px",
                            "title": {"en": "Discharge Power (kW)"},
                            "attr": "esDischargePower",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Discharge Power Factor (+/-)"},
                            "attr": "esDischgPwrFactor",
                            "filter": false,
                            "sort": true,
                            "step": 0.001,
                            "min": -1,
                            "max": 1,
                            "default": "1"
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Min. SoC (%)"},
                            "attr": "esSoCMin",
                            "filter": false,
                            "step": 1,
                            "min": 0,
                            "max": 100,
                            "unit": "%",
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Max. SoC (%)"},
                            "attr": "esSoCMax",
                            "filter": false,
                            "step": 1,
                            "min": 0,
                            "max": 100,
                            "unit": "%",
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "objectId",
                            "width": "50px",
                            "title": {"en": "SoC (%)"},
                            "attr": "esSoC",
                            "filter": false,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": ""
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Shutdown Delay (s)"},
                            "attr": "esChannelShutdownDelay",
                            "filter": false,
                            "step": 1,
                            "min": 0,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": "2"
                        },
                        {
                            "type": "number",
                            "width": "50px",
                            "title": {"en": "Activation Delay (s)"},
                            "attr": "esChannelActivationDelay",
                            "filter": false,
                            "step": 1,
                            "min": 0,
                            "sort": true,
                            "style":{"textAlign": "right"},
                            "default": "2"
                        }
                    ]

                }
            }
        }
    }

}